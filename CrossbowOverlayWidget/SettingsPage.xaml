<Page x:Class="CrossbowOverlayWidget.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      Loaded="Page_Loaded">

    <Page.Resources>
        <AcrylicBrush x:Key="CardBrush"
                      BackgroundSource="Backdrop"
                      TintColor="#1A1A2E"
                      TintOpacity="0.6"
                      FallbackColor="#2D2D44"/>
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#AACCDDFF"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Pivot x:Name="MainPivot" Margin="4,0">
            <!-- ==================== Tab 1: Style ==================== -->
            <PivotItem Header="样式">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Padding="4">

                        <!-- Live Preview -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="实时预览" Style="{StaticResource SectionHeader}"/>
                                <canvas:CanvasControl x:Name="PreviewCanvas" Height="120"
                                                      Draw="OnPreviewDraw"
                                                      ClearColor="#0A000000"
                                                      CornerRadius="6"/>
                            </StackPanel>
                        </Border>

                        <!-- Preset selector -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="预设管理" Style="{StaticResource SectionHeader}"/>
                                <ComboBox x:Name="PresetCombo"
                                          Header="当前预设"
                                          HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="OnPresetSelectionChanged"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="新建" Click="OnCreatePreset"
                                            Background="#3300AAFF" Foreground="White"
                                            CornerRadius="4" Padding="10,4" FontSize="11"/>
                                    <Button Content="删除" Click="OnDeletePreset"
                                            Background="#33FF4444" Foreground="White"
                                            CornerRadius="4" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Shape & Animation -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="形状与动画" Style="{StaticResource SectionHeader}"/>
                                <ComboBox x:Name="ShapeCombo"
                                          Header="准星形状"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnShapeChanged">
                                    <ComboBoxItem Content="十字 (Cross)"/>
                                    <ComboBoxItem Content="圆点 (Dot)"/>
                                    <ComboBoxItem Content="菱形 (Diamond)"/>
                                    <ComboBoxItem Content="圆圈 (Circle)"/>
                                    <ComboBoxItem Content="T形 (T-Shape)"/>
                                </ComboBox>
                                <ComboBox x:Name="AnimationCombo"
                                          Header="动画效果"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnAnimationChanged">
                                    <ComboBoxItem Content="无"/>
                                    <ComboBoxItem Content="脉冲 (Pulse)"/>
                                    <ComboBoxItem Content="呼吸 (Breathing)"/>
                                    <ComboBoxItem Content="淡入 (FadeIn)"/>
                                </ComboBox>
                                <Slider x:Name="AnimSpeedSlider"
                                        Header="动画速度"
                                        Minimum="0.1" Maximum="5.0" StepFrequency="0.1"
                                        Value="1.0"
                                        ValueChanged="OnAnimSpeedChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Colors -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="颜色" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="MajorColorBox" Header="主刻度颜色"
                                         LostFocus="OnColorChanged" PlaceholderText="#CC00FF00"/>
                                <TextBox x:Name="MinorColorBox" Header="副刻度颜色"
                                         LostFocus="OnColorChanged" PlaceholderText="#8800FF00"/>
                                <TextBox x:Name="TextColorBox" Header="文字颜色"
                                         LostFocus="OnColorChanged" PlaceholderText="#CCFFFFFF"/>
                                <TextBox x:Name="CenterColorBox" Header="中心线颜色"
                                         LostFocus="OnColorChanged" PlaceholderText="#CCFF0000"/>

                                <!-- v2: Gradient color -->
                                <ToggleSwitch x:Name="GradientToggle"
                                              Header="距离颜色渐变"
                                              Toggled="OnGradientToggled"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBox x:Name="NearColorBox" Header="近距离颜色"
                                             Width="130" LostFocus="OnGradientColorChanged"
                                             PlaceholderText="#CC00FF00"/>
                                    <TextBox x:Name="FarColorBox" Header="远距离颜色"
                                             Width="130" LostFocus="OnGradientColorChanged"
                                             PlaceholderText="#CCFF4444"/>
                                </StackPanel>

                                <!-- v2: Night mode -->
                                <ToggleSwitch x:Name="NightModeToggle"
                                              Header="夜间模式 (暗红)"
                                              Toggled="OnNightModeToggled"/>
                            </StackPanel>
                        </Border>

                        <!-- Size sliders -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="尺寸参数" Style="{StaticResource SectionHeader}"/>
                                <Slider x:Name="ScaleSlider" Header="缩放倍率"
                                        Minimum="0.2" Maximum="5.0" StepFrequency="0.05"
                                        ValueChanged="OnSliderChanged"/>
                                <Slider x:Name="SpacingSlider" Header="刻度间距"
                                        Minimum="10" Maximum="200" StepFrequency="1"
                                        ValueChanged="OnSliderChanged"/>
                                <Slider x:Name="OpacitySlider" Header="整体透明度"
                                        Minimum="0.0" Maximum="1.0" StepFrequency="0.05"
                                        ValueChanged="OnSliderChanged"/>
                                <Slider x:Name="MajorWidthSlider" Header="主刻度线宽"
                                        Minimum="0.5" Maximum="6.0" StepFrequency="0.5"
                                        ValueChanged="OnSliderChanged"/>
                                <Slider x:Name="MinorWidthSlider" Header="副刻度线宽"
                                        Minimum="0.5" Maximum="4.0" StepFrequency="0.5"
                                        ValueChanged="OnSliderChanged"/>
                                <Slider x:Name="OffsetXSlider" Header="水平偏移"
                                        Minimum="-500" Maximum="500" StepFrequency="1"
                                        ValueChanged="OnSliderChanged"/>
                                <Slider x:Name="OffsetYSlider" Header="垂直偏移"
                                        Minimum="-500" Maximum="500" StepFrequency="1"
                                        ValueChanged="OnSliderChanged"/>

                                <!-- v2: Center gap -->
                                <Slider x:Name="CenterGapSlider" Header="中心断开间距"
                                        Minimum="0" Maximum="100" StepFrequency="1"
                                        ValueChanged="OnSliderChanged"/>

                                <!-- v2: Taper -->
                                <Slider x:Name="TaperSlider" Header="锥度效果"
                                        Minimum="0" Maximum="1.0" StepFrequency="0.05"
                                        ValueChanged="OnSliderChanged"/>

                                <!-- v2: Center lock -->
                                <ToggleSwitch x:Name="CenterLockToggle"
                                              Header="准星居中锁定"
                                              Toggled="OnCenterLockToggled"/>

                                <!-- v2: Label position -->
                                <ComboBox x:Name="LabelPositionCombo"
                                          Header="标签位置"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnLabelPositionChanged">
                                    <ComboBoxItem Content="右侧 (Right)"/>
                                    <ComboBoxItem Content="左侧 (Left)"/>
                                    <ComboBoxItem Content="交替 (Alternate)"/>
                                    <ComboBoxItem Content="隐藏 (Hidden)"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ==================== Tab 2: Calibration ==================== -->
            <PivotItem Header="校准">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Padding="4">

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="两点线性校准" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="选择2个已知刻度点，自动计算全部刻度的偏移量"
                                           FontSize="11" Foreground="#88AAAAAA"
                                           TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="Calib1Combo" Header="校准点1"
                                              Width="120" DisplayMemberPath="Label"/>
                                    <ComboBox x:Name="Calib2Combo" Header="校准点2"
                                              Width="120" DisplayMemberPath="Label"/>
                                </StackPanel>

                                <TextBlock Text="生成刻度范围" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBox x:Name="RangeMinBox" Header="最小(m)"
                                             Width="80" Text="0" InputScope="Number"/>
                                    <TextBox x:Name="RangeMaxBox" Header="最大(m)"
                                             Width="80" Text="350" InputScope="Number"/>
                                    <TextBox x:Name="RangeStepBox" Header="间距(m)"
                                             Width="80" Text="50" InputScope="Number"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <Button Content="执行校准" Click="OnCalibrateClick"
                                            Background="#33FF6347" Foreground="White"
                                            CornerRadius="4" Padding="12,6"
                                            FontWeight="Bold"/>
                                    <Button Content="恢复默认" Click="OnRestoreClick"
                                            Background="#33666666" Foreground="White"
                                            CornerRadius="4" Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Spacing="6">
                                <Button Content="💾 保存配置" Click="OnSaveClick"
                                        HorizontalAlignment="Stretch"
                                        Background="#3300CC66" Foreground="White"
                                        CornerRadius="4" Padding="12,8"
                                        FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ==================== Tab 3: Configuration ==================== -->
            <PivotItem Header="配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4" Padding="4">

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="游戏配置 Profile" Style="{StaticResource SectionHeader}"/>
                                <ComboBox x:Name="ProfileCombo"
                                          Header="当前配置"
                                          HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="OnProfileSelectionChanged"/>
                                <TextBox x:Name="ProfileGameExeBox"
                                         Header="游戏进程名"
                                         PlaceholderText="e.g. Gameloop.exe"
                                         LostFocus="OnGameExeChanged"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="新建 Profile" Click="OnCreateProfile"
                                            Background="#3300AAFF" Foreground="White"
                                            CornerRadius="4" Padding="10,4" FontSize="11"/>
                                    <Button Content="切换到此 Profile" Click="OnSwitchProfile"
                                            Background="#33FF8800" Foreground="White"
                                            CornerRadius="4" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="导入/导出" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="将配置导出为 JSON 文件，或从文件导入"
                                           FontSize="11" Foreground="#88AAAAAA"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="📤 导出配置" Click="OnExportClick"
                                            Background="#338844FF" Foreground="White"
                                            CornerRadius="4" Padding="12,6"/>
                                    <Button Content="📥 导入配置" Click="OnImportClick"
                                            Background="#334488FF" Foreground="White"
                                            CornerRadius="4" Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="关于" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="爆炸猎弓准星 v2.1"
                                           FontSize="12" Foreground="#AAFFFFFF"/>
                                <TextBlock Text="UWP Xbox Game Bar Widget&#x0a;Win2D GPU 渲染 + MVVM 架构&#x0a;中心断裂 · 距离渐变 · 夜间模式 · 锥度效果"
                                           FontSize="10" Foreground="#66AAAAAA"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <!-- Status toast -->
        <Border x:Name="StatusToast"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="#CC1A1A2E"
                CornerRadius="8,8,0,0"
                Padding="12,6"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="11"
                       Foreground="#CC88FF88"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
