<Page x:Class="CrossbowOverlayWidget.WidgetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
      Background="Transparent"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <AcrylicBrush x:Key="SettingsBrush"
                      BackgroundSource="Backdrop"
                      TintColor="#1A1A2E"
                      TintOpacity="0.8"
                      FallbackColor="#EE1A1A2E"/>
        <Style x:Key="SLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#BBCCDDFF"/>
            <Setter Property="Margin" Value="0,4,0,1"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <!-- === Layer 1: Reticle Canvas (always visible) === -->
        <canvas:CanvasControl x:Name="ReticleCanvas"
                              Draw="OnCanvasDraw"
                              ClearColor="Transparent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>

        <!-- === Layer 2: Status bar (top-left) === -->
        <StackPanel x:Name="StatusBar"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="6,4,0,0"
                    Opacity="0.7"
                    Spacing="6">
            <TextBlock x:Name="ProfileLabel" Text=""
                       FontFamily="Consolas" FontSize="10"
                       Foreground="#AA88CCFF"/>
            <TextBlock Text="|" FontFamily="Consolas" FontSize="10"
                       Foreground="#66FFFFFF"/>
            <TextBlock x:Name="PresetLabel" Text=""
                       FontFamily="Consolas" FontSize="10"
                       Foreground="#AACCFFAA"/>
        </StackPanel>

        <!-- === Layer 3: Quick buttons (bottom, when settings hidden) === -->
        <StackPanel x:Name="QuickButtons"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,6"
                    Spacing="4"
                    Opacity="0.6">
            <Button x:Name="PrevBtn" Content="◀"
                    FontSize="12" Padding="6,2"
                    Background="#44000000" Foreground="#CCFFFFFF"
                    BorderThickness="0" CornerRadius="4"
                    Click="OnPrevPreset"/>
            <Button x:Name="ToggleBtn" Content="👁"
                    FontSize="12" Padding="6,2"
                    Background="#44000000" Foreground="#CCFFFFFF"
                    BorderThickness="0" CornerRadius="4"
                    Click="OnToggleVisibility"/>
            <Button x:Name="NextBtn" Content="▶"
                    FontSize="12" Padding="6,2"
                    Background="#44000000" Foreground="#CCFFFFFF"
                    BorderThickness="0" CornerRadius="4"
                    Click="OnNextPreset"/>
            <Button Content="⚙"
                    FontSize="12" Padding="6,2"
                    Background="#44000000" Foreground="#CCFFFFFF"
                    BorderThickness="0" CornerRadius="4"
                    Click="OnToggleSettings"/>
        </StackPanel>

        <!-- === Layer 4: Settings Panel (overlay, toggleable) === -->
        <Grid x:Name="SettingsPanel"
              Visibility="Collapsed">
            <!-- Semi-transparent backdrop -->
            <Border Background="{StaticResource SettingsBrush}"
                    CornerRadius="0"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Settings header -->
                <Border Grid.Row="0" Background="#44000000" Padding="8,6">
                    <Grid>
                        <TextBlock Text="⚙ 设置" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                            <Button Content="💾" Click="OnSaveClick" Padding="6,3"
                                    Background="#3300CC66" Foreground="White"
                                    BorderThickness="0" CornerRadius="4" FontSize="11"/>
                            <Button Content="✕" Click="OnCloseSettings"
                                    Padding="6,3"
                                    Background="#44FF4444" Foreground="White"
                                    BorderThickness="0" CornerRadius="4" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Settings content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Padding="8,4">
                    <StackPanel Spacing="2">

                        <!-- Preset -->
                        <TextBlock Text="预设" Style="{StaticResource SLabel}"/>
                        <ComboBox x:Name="PresetCombo"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnPresetSelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                            <Button Content="新建" Click="OnCreatePreset"
                                    Background="#3300AAFF" Foreground="White"
                                    CornerRadius="3" Padding="8,3" FontSize="10"/>
                            <Button Content="复制" Click="OnDuplicatePreset"
                                    Background="#33AA66FF" Foreground="White"
                                    CornerRadius="3" Padding="8,3" FontSize="10"/>
                            <Button Content="删除" Click="OnDeletePreset"
                                    Background="#33FF4444" Foreground="White"
                                    CornerRadius="3" Padding="8,3" FontSize="10"/>
                        </StackPanel>

                        <!-- Shape -->
                        <TextBlock Text="形状" Style="{StaticResource SLabel}"/>
                        <ComboBox x:Name="ShapeCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnShapeChanged">
                            <ComboBoxItem Content="十字"/>
                            <ComboBoxItem Content="圆点"/>
                            <ComboBoxItem Content="菱形"/>
                            <ComboBoxItem Content="圆圈"/>
                            <ComboBoxItem Content="T形"/>
                        </ComboBox>

                        <!-- Scale -->
                        <TextBlock Text="缩放倍率" Style="{StaticResource SLabel}"/>
                        <Slider x:Name="ScaleSlider" Minimum="0.2" Maximum="5.0"
                                StepFrequency="0.05" ValueChanged="OnSliderChanged"/>

                        <!-- Spacing -->
                        <TextBlock Text="刻度间距" Style="{StaticResource SLabel}"/>
                        <Slider x:Name="SpacingSlider" Minimum="10" Maximum="200"
                                StepFrequency="1" ValueChanged="OnSliderChanged"/>

                        <!-- Opacity -->
                        <TextBlock Text="透明度" Style="{StaticResource SLabel}"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.0" Maximum="1.0"
                                StepFrequency="0.05" ValueChanged="OnSliderChanged"/>

                        <!-- Line widths -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel Width="120">
                                <TextBlock Text="主线宽" Style="{StaticResource SLabel}"/>
                                <Slider x:Name="MajorWidthSlider" Minimum="0.5" Maximum="6.0"
                                        StepFrequency="0.5" ValueChanged="OnSliderChanged"/>
                            </StackPanel>
                            <StackPanel Width="120">
                                <TextBlock Text="副线宽" Style="{StaticResource SLabel}"/>
                                <Slider x:Name="MinorWidthSlider" Minimum="0.5" Maximum="4.0"
                                        StepFrequency="0.5" ValueChanged="OnSliderChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Animation -->
                        <TextBlock Text="动画" Style="{StaticResource SLabel}"/>
                        <ComboBox x:Name="AnimationCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnAnimationChanged">
                            <ComboBoxItem Content="无"/>
                            <ComboBoxItem Content="脉冲"/>
                            <ComboBoxItem Content="呼吸"/>
                            <ComboBoxItem Content="淡入"/>
                        </ComboBox>
                        <TextBlock Text="动画速度" Style="{StaticResource SLabel}"/>
                        <Slider x:Name="AnimSpeedSlider" Minimum="0.1" Maximum="5.0"
                                StepFrequency="0.1" ValueChanged="OnAnimSpeedChanged"/>

                        <!-- Colors -->
                        <TextBlock Text="颜色" Style="{StaticResource SLabel}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="MajorColorBox" Header="主刻度" Width="100"
                                     FontSize="10" LostFocus="OnColorChanged"
                                     PlaceholderText="#CC00FF00"/>
                            <TextBox x:Name="MinorColorBox" Header="副刻度" Width="100"
                                     FontSize="10" LostFocus="OnColorChanged"
                                     PlaceholderText="#8800FF00"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="TextColorBox" Header="文字" Width="100"
                                     FontSize="10" LostFocus="OnColorChanged"
                                     PlaceholderText="#CCFFFFFF"/>
                            <TextBox x:Name="CenterColorBox" Header="中心线" Width="100"
                                     FontSize="10" LostFocus="OnColorChanged"
                                     PlaceholderText="#CCFF0000"/>
                        </StackPanel>

                        <!-- v2 Features -->
                        <TextBlock Text="高级" Style="{StaticResource SLabel}" Margin="0,6,0,0"/>
                        <ToggleSwitch x:Name="NightModeToggle" Header="夜间模式"
                                      FontSize="11" OnContent="开" OffContent="关"
                                      Toggled="OnNightModeToggled"/>
                        <ToggleSwitch x:Name="CenterLockToggle" Header="居中锁定"
                                      FontSize="11" OnContent="开" OffContent="关"
                                      Toggled="OnCenterLockToggled"/>
                        <ToggleSwitch x:Name="GradientToggle" Header="距离渐变"
                                      FontSize="11" OnContent="开" OffContent="关"
                                      Toggled="OnGradientToggled"/>

                        <!-- Center gap & Taper -->
                        <TextBlock Text="中心断开" Style="{StaticResource SLabel}"/>
                        <Slider x:Name="CenterGapSlider" Minimum="0" Maximum="100"
                                StepFrequency="1" ValueChanged="OnSliderChanged"/>
                        <TextBlock Text="锥度" Style="{StaticResource SLabel}"/>
                        <Slider x:Name="TaperSlider" Minimum="0" Maximum="1.0"
                                StepFrequency="0.05" ValueChanged="OnSliderChanged"/>

                        <!-- Offset -->
                        <TextBlock Text="偏移" Style="{StaticResource SLabel}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel Width="120">
                                <TextBlock Text="水平" Style="{StaticResource SLabel}"/>
                                <Slider x:Name="OffsetXSlider" Minimum="-500" Maximum="500"
                                        StepFrequency="1" ValueChanged="OnSliderChanged"/>
                            </StackPanel>
                            <StackPanel Width="120">
                                <TextBlock Text="垂直" Style="{StaticResource SLabel}"/>
                                <Slider x:Name="OffsetYSlider" Minimum="-500" Maximum="500"
                                        StepFrequency="1" ValueChanged="OnSliderChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Label position -->
                        <TextBlock Text="标签位置" Style="{StaticResource SLabel}"/>
                        <ComboBox x:Name="LabelPositionCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnLabelPositionChanged">
                            <ComboBoxItem Content="右侧"/>
                            <ComboBoxItem Content="左侧"/>
                            <ComboBoxItem Content="交替"/>
                            <ComboBoxItem Content="隐藏"/>
                        </ComboBox>

                        <!-- Calibration -->
                        <TextBlock Text="校准" Style="{StaticResource SLabel}" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ComboBox x:Name="Calib1Combo" Width="100" Header="点1"
                                      DisplayMemberPath="Label" FontSize="10"/>
                            <ComboBox x:Name="Calib2Combo" Width="100" Header="点2"
                                      DisplayMemberPath="Label" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="RangeMinBox" Header="最小" Width="65"
                                     Text="0" InputScope="Number" FontSize="10"/>
                            <TextBox x:Name="RangeMaxBox" Header="最大" Width="65"
                                     Text="350" InputScope="Number" FontSize="10"/>
                            <TextBox x:Name="RangeStepBox" Header="间距" Width="65"
                                     Text="50" InputScope="Number" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4">
                            <Button Content="校准" Click="OnCalibrateClick"
                                    Background="#33FF6347" Foreground="White"
                                    CornerRadius="3" Padding="8,3" FontSize="10"/>
                            <Button Content="恢复默认" Click="OnRestoreClick"
                                    Background="#33666666" Foreground="White"
                                    CornerRadius="3" Padding="8,3" FontSize="10"/>
                        </StackPanel>

                        <!-- Profile -->
                        <TextBlock Text="Profile" Style="{StaticResource SLabel}" Margin="0,6,0,0"/>
                        <ComboBox x:Name="ProfileCombo"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnProfileSelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                            <Button Content="新建" Click="OnCreateProfile"
                                    Background="#3300AAFF" Foreground="White"
                                    CornerRadius="3" Padding="8,3" FontSize="10"/>
                            <Button Content="切换" Click="OnSwitchProfile"
                                    Background="#33FF8800" Foreground="White"
                                    CornerRadius="3" Padding="8,3" FontSize="10"/>
                            <Button Content="删除" Click="OnDeleteProfile"
                                    Background="#33FF4444" Foreground="White"
                                    CornerRadius="3" Padding="8,3" FontSize="10"/>
                        </StackPanel>

                        <!-- Import/Export -->
                        <TextBlock Text="配置" Style="{StaticResource SLabel}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                            <Button Content="📤 导出" Click="OnExportClick"
                                    Background="#338844FF" Foreground="White"
                                    CornerRadius="3" Padding="8,3" FontSize="10"/>
                            <Button Content="📥 导入" Click="OnImportClick"
                                    Background="#334488FF" Foreground="White"
                                    CornerRadius="3" Padding="8,3" FontSize="10"/>
                        </StackPanel>

                        <!-- About -->
                        <TextBlock Text="爆炸猎弓准星 v3.1 (单进程版)"
                                   FontSize="9" Foreground="#55AAAAAA"
                                   Margin="0,8,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status toast -->
        <Border x:Name="StatusToast"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="#CC1A1A2E"
                CornerRadius="8,8,0,0"
                Padding="12,6"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="11"
                       Foreground="#CC88FF88"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
